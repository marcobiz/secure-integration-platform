{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.secure-integration.example/connector-definition/v1/schema.json",
  "title": "Secure Integration Connector Definition v1",
  "description": "Provider-neutral, declarative connector contract. Endpoint and secret values are bound server-side and never appear here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "connectorId", "version", "displayName", "bindings", "operations"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "connectorId": { "$ref": "#/$defs/identifier" },
    "version": { "$ref": "#/$defs/semanticVersion" },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 256 },
    "description": { "type": "string", "maxLength": 4000 },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoints", "secrets"],
      "properties": {
        "endpoints": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": { "name": { "$ref": "#/$defs/identifier" } }
          }
        },
        "secrets": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "kind"],
            "properties": {
              "name": { "$ref": "#/$defs/identifier" },
              "kind": { "enum": ["opaque", "username", "password", "clientCertificate"] }
            }
          }
        }
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/operation" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{2,99}$"
    },
    "semanticVersion": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "endpointBinding", "method", "request", "response", "authentication", "timeoutMs", "redirectPolicy", "allowedClientHeaders"],
      "properties": {
        "operationId": { "$ref": "#/$defs/identifier" },
        "endpointBinding": { "$ref": "#/$defs/identifier" },
        "method": { "enum": ["GET", "POST", "PUT", "DELETE"] },
        "path": {
          "type": "string",
          "pattern": "^/",
          "maxLength": 1024,
          "not": { "pattern": "(^|/)\\.\\.(/|$)|[?#]" }
        },
        "pathResolution": {
          "enum": ["authorityRoot", "appendToBasePath"],
          "default": "authorityRoot"
        },
        "pathTemplate": {
          "type": "string",
          "pattern": "^/(?!/)",
          "maxLength": 1024,
          "not": { "pattern": "[?#%\\\\\\u0000-\\u001F\\u007F-\\u009F]" }
        },
        "request": { "$ref": "#/$defs/messagePolicy" },
        "response": { "$ref": "#/$defs/responsePolicy" },
        "authentication": { "$ref": "#/$defs/authentication" },
        "executionStrategy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9._-]*[a-z0-9]$|^[a-z]$"
        },
        "typedSessionHandshake": { "$ref": "#/$defs/typedSessionHandshake" },
        "typedComposedSoapRequest": { "$ref": "#/$defs/typedComposedSoapRequest" },
        "extensionConfiguration": { "$ref": "#/$defs/extensionConfiguration" },
        "authorizedCapabilities": { "$ref": "#/$defs/authorizedCapabilities" },
        "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 120000 },
        "redirectPolicy": { "const": "deny" },
        "allowedClientHeaders": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9-]+$", "maxLength": 64 }
        },
        "idempotent": { "type": "boolean", "default": false },
        "maximumRetries": { "type": "integer", "minimum": 0, "maximum": 2, "default": 0 }
      },
      "oneOf": [
        {
          "required": ["path"],
          "properties": { "path": true }
        },
        {
          "required": ["pathTemplate"],
          "properties": { "pathTemplate": true }
        }
      ]
    },
    "messagePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contentType", "maximumBytes"],
      "properties": {
        "contentType": { "type": "string", "minLength": 3, "maxLength": 128 },
        "maximumBytes": { "type": "integer", "minimum": 1, "maximum": 16777216 }
      }
    },
    "responsePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximumBytes"],
      "properties": { "maximumBytes": { "type": "integer", "minimum": 1, "maximum": 16777216 } }
    },
    "authentication": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "none" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "usernameBinding", "passwordBinding"],
          "properties": {
            "kind": { "const": "basic" },
            "usernameBinding": { "$ref": "#/$defs/identifier" },
            "passwordBinding": { "$ref": "#/$defs/identifier" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "policyId", "sessionProfileId", "secretBinding", "headerName", "valueFormat"],
          "properties": {
            "kind": { "const": "opaqueSessionHttp" },
            "policyId": { "$ref": "#/$defs/identifier" },
            "sessionProfileId": { "$ref": "#/$defs/identifier" },
            "secretBinding": { "$ref": "#/$defs/identifier" },
            "headerName": { "$ref": "#/$defs/safeOpaqueSessionHeader" },
            "valueFormat": { "enum": ["rawOpaqueValue", "fixedSchemeAndOpaqueValue"] },
            "fixedScheme": { "$ref": "#/$defs/httpToken" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "policyId", "sessionProfileId", "usernameBinding", "passwordBinding", "secretBinding", "headerName", "valueFormat", "soapHttp"],
          "properties": {
            "kind": { "const": "soapBasicOpaqueSession" },
            "policyId": { "$ref": "#/$defs/identifier" },
            "sessionProfileId": { "$ref": "#/$defs/identifier" },
            "usernameBinding": { "$ref": "#/$defs/identifier" },
            "passwordBinding": { "$ref": "#/$defs/identifier" },
            "secretBinding": { "$ref": "#/$defs/identifier" },
            "headerName": { "$ref": "#/$defs/safeOpaqueSessionHeader" },
            "valueFormat": { "enum": ["rawOpaqueValue", "fixedSchemeAndOpaqueValue"] },
            "fixedScheme": { "$ref": "#/$defs/httpToken" },
            "soapHttp": { "$ref": "#/$defs/soapHttpRequestMetadata" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "secretBinding", "headerName"],
          "properties": {
            "kind": { "const": "apiKey" },
            "secretBinding": { "$ref": "#/$defs/identifier" },
            "headerName": { "$ref": "#/$defs/safeHeader" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "certificateBinding"],
          "properties": {
            "kind": { "const": "mtls" },
            "certificateBinding": { "$ref": "#/$defs/identifier" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "secretBinding", "headerName", "certificateBinding"],
          "properties": {
            "kind": { "const": "apiKeyAndMtls" },
            "secretBinding": { "$ref": "#/$defs/identifier" },
            "headerName": { "$ref": "#/$defs/safeHeader" },
            "certificateBinding": { "$ref": "#/$defs/identifier" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "profileId", "authorizationEndpointBinding", "tokenEndpointBinding", "clientId", "clientAuthMethod", "secretBinding", "scopes", "redirectUri"],
          "properties": {
            "kind": { "const": "oauthAuthorizationCode" },
            "profileId": { "$ref": "#/$defs/identifier" },
            "authorizationEndpointBinding": { "$ref": "#/$defs/identifier" },
            "tokenEndpointBinding": { "$ref": "#/$defs/identifier" },
            "clientId": { "$ref": "#/$defs/oauthClientId" },
            "clientAuthMethod": { "const": "client_secret_basic" },
            "secretBinding": { "$ref": "#/$defs/identifier" },
            "scopes": { "$ref": "#/$defs/oauthScopes" },
            "audience": { "$ref": "#/$defs/oauthParameter" },
            "redirectUri": { "type": "string", "pattern": "^https://(?![^/?#]*@)[^?#\\u0000-\\u001F\\u007F-\\u009F]+$", "maxLength": 2048 },
            "pkcePolicy": { "enum": ["NONE", "S256_REQUIRED"] },
            "authorizationLifetimeSeconds": { "type": "integer", "minimum": 60, "maximum": 1800 },
            "tokenRequestTimeoutMilliseconds": { "type": "integer", "minimum": 100, "maximum": 30000 },
            "maximumTokenResponseBytes": { "type": "integer", "minimum": 256, "maximum": 65536 },
            "expirySkewSeconds": { "type": "integer", "minimum": 0, "maximum": 300 },
            "allowRefresh": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "profileId", "tokenEndpointBinding", "clientId", "clientAuthMethod", "secretBinding", "scopes"],
          "properties": {
            "kind": { "const": "oauthClientCredentials" },
            "profileId": { "$ref": "#/$defs/identifier" },
            "tokenEndpointBinding": { "$ref": "#/$defs/identifier" },
            "clientId": { "$ref": "#/$defs/oauthClientId" },
            "clientAuthMethod": { "const": "client_secret_basic" },
            "secretBinding": { "$ref": "#/$defs/identifier" },
            "scopes": { "$ref": "#/$defs/oauthScopes" },
            "audience": { "$ref": "#/$defs/oauthParameter" },
            "resource": { "$ref": "#/$defs/oauthParameter" },
            "tokenRequestTimeoutMilliseconds": { "type": "integer", "minimum": 100, "maximum": 30000 },
            "maximumTokenResponseBytes": { "type": "integer", "minimum": 256, "maximum": 65536 },
            "expirySkewSeconds": { "type": "integer", "minimum": 0, "maximum": 300 }
          }
        }
      ]
    },
    "typedSessionHandshake": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileId", "soapVersion", "action", "requestElement", "responseElement", "requestAdapter", "responseAdapter", "sessionLifetimeSeconds"],
      "properties": {
        "profileId": { "$ref": "#/$defs/identifier" },
        "soapVersion": { "enum": ["1.1", "1.2"] },
        "action": { "type": "string", "minLength": 3, "maxLength": 2048, "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\u0000-\\u0020\\u007F-\\u009F]+$" },
        "requestElement": { "$ref": "#/$defs/xmlQualifiedName" },
        "responseElement": { "$ref": "#/$defs/xmlQualifiedName" },
        "requestAdapter": { "$ref": "#/$defs/compiledAdapter" },
        "responseAdapter": { "$ref": "#/$defs/compiledAdapter" },
        "serverOwnedInputs": { "$ref": "#/$defs/serverOwnedInputs" },
        "sessionLifetimeSeconds": { "type": "integer", "minimum": 60, "maximum": 604800 },
        "externalAdmission": {
          "type": "object",
          "additionalProperties": false,
          "required": ["validator", "endpointBinding", "path", "soapVersion", "action", "requestElement", "responseElement", "intentLifetimeSeconds", "timeoutMs", "maximumRequestBytes", "maximumResponseBytes"],
          "properties": {
            "validator": { "$ref": "#/$defs/compiledAdapter" },
            "serverOwnedInputs": { "$ref": "#/$defs/serverOwnedInputs" },
            "endpointBinding": { "$ref": "#/$defs/identifier" },
            "path": {
              "type": "string",
              "pattern": "^/",
              "maxLength": 1024,
              "not": { "pattern": "(^|/)\\.\\.(/|$)|[?#]" }
            },
            "soapVersion": { "enum": ["1.1", "1.2"] },
            "action": { "type": "string", "minLength": 3, "maxLength": 2048, "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\u0000-\\u0020\\u007F-\\u009F]+$" },
            "requestElement": { "$ref": "#/$defs/xmlQualifiedName" },
            "responseElement": { "$ref": "#/$defs/xmlQualifiedName" },
            "intentLifetimeSeconds": { "type": "integer", "minimum": 30, "maximum": 1800 },
            "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 120000 },
            "maximumRequestBytes": { "type": "integer", "minimum": 256, "maximum": 16777216 },
            "maximumResponseBytes": { "type": "integer", "minimum": 256, "maximum": 16777216 }
          }
        }
      }
    },
    "typedComposedSoapRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestAdapter", "requestElement"],
      "properties": {
        "requestAdapter": { "$ref": "#/$defs/compiledAdapter" },
        "requestElement": { "$ref": "#/$defs/xmlQualifiedName" },
        "serverOwnedInputs": { "$ref": "#/$defs/serverOwnedInputs" }
      }
    },
    "serverOwnedInputs": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "secretBinding"],
        "properties": {
          "name": { "$ref": "#/$defs/identifier" },
          "secretBinding": { "$ref": "#/$defs/identifier" }
        }
      }
    },
    "extensionConfiguration": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": { "type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
      "additionalProperties": { "$ref": "#/$defs/extensionValue" }
    },
    "extensionValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 },
        { "type": "string", "maxLength": 4096, "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*$" },
        {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/extensionValue" }
        },
        {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": { "type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
          "additionalProperties": { "$ref": "#/$defs/extensionValue" }
        }
      ]
    },
    "authorizedCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["restrictedTransport"],
      "properties": {
        "signing": { "$ref": "#/$defs/invocationSigning" },
        "signingSlots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/invocationSigningSlot" }
        },
        "restrictedTransport": { "type": "object" }
      },
      "oneOf": [
        {
          "required": ["signing"],
          "not": {
            "required": ["signingSlots"],
            "properties": { "signingSlots": true }
          },
          "properties": {
            "signing": true,
            "restrictedTransport": { "$ref": "#/$defs/legacyInvocationRestrictedTransport" }
          }
        },
        {
          "required": ["signingSlots"],
          "not": {
            "required": ["signing"],
            "properties": { "signing": true }
          },
          "properties": {
            "signingSlots": true,
            "restrictedTransport": { "$ref": "#/$defs/invocationRestrictedTransport" }
          }
        }
      ]
    },
    "invocationSigning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileId", "revision", "keyBinding", "publicKeySpkiSha256", "issuer", "audience", "subject", "allowedClaims", "tokenLifetimeSeconds", "clockSkewSeconds", "certificateHeader", "temporalClaims", "minimumRsaKeySize"],
      "properties": {
        "profileId": { "$ref": "#/$defs/identifier" },
        "revision": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "keyBinding": { "$ref": "#/$defs/identifier" },
        "publicKeySpkiSha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
        "issuer": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$" },
        "audience": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$" },
        "subject": { "enum": ["installation", "application", "tenant", "fixed"] },
        "fixedSubject": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$" },
        "allowedClaims": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z][A-Za-z0-9._-]*$" }
        },
        "tokenLifetimeSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "clockSkewSeconds": { "type": "integer", "minimum": 0, "maximum": 300 },
        "certificateKeyUsage": { "enum": ["digitalSignature", "contentCommitment"] },
        "certificateHeader": { "enum": ["none", "leaf", "chain"] },
        "temporalClaims": { "enum": ["iat-exp", "iat-nbf-exp"] },
        "minimumRsaKeySize": { "type": "integer", "minimum": 2048, "maximum": 16384 }
      },
      "allOf": [
        {
          "if": { "properties": { "subject": { "const": "fixed" } }, "required": ["subject"] },
          "then": { "properties": { "fixedSubject": true }, "required": ["fixedSubject"] },
          "else": { "properties": { "fixedSubject": false } }
        }
      ]
    },
    "invocationSigningSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot", "required", "signing", "projection"],
      "properties": {
        "slot": { "$ref": "#/$defs/signingSlotKey" },
        "required": { "type": "boolean" },
        "signing": { "$ref": "#/$defs/invocationSigning" },
        "projection": { "$ref": "#/$defs/signedTokenProjection" }
      }
    },
    "signedTokenProjection": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "authorizationBearer" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "headerName"],
          "properties": {
            "kind": { "const": "signedTokenHeader" },
            "headerName": { "$ref": "#/$defs/safeSignedTokenHeader" }
          }
        }
      ]
    },
    "legacyInvocationRestrictedTransport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileId", "revision", "clientCertificateSpkiSha256", "authorization", "nearExpirySeconds"],
      "properties": {
        "profileId": { "$ref": "#/$defs/identifier" },
        "revision": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "clientCertificateSpkiSha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
        "authorization": { "const": "signedTokenBearer" },
        "nearExpirySeconds": { "type": "integer", "minimum": 0, "maximum": 300 },
        "bodyMode": { "enum": ["required", "none"] }
      }
    },
    "invocationRestrictedTransport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileId", "revision", "clientCertificateSpkiSha256", "nearExpirySeconds"],
      "properties": {
        "profileId": { "$ref": "#/$defs/identifier" },
        "revision": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "clientCertificateSpkiSha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
        "nearExpirySeconds": { "type": "integer", "minimum": 0, "maximum": 300 },
        "bodyMode": { "enum": ["required", "none"] }
      }
    },
    "compiledAdapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "$ref": "#/$defs/identifier" }
      }
    },
    "xmlQualifiedName": {
      "type": "object",
      "additionalProperties": false,
      "required": ["localName", "namespaceUri"],
      "properties": {
        "localName": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,99}$" },
        "namespaceUri": { "type": "string", "minLength": 3, "maxLength": 2048, "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\u0000-\\u0020\\u007F-\\u009F]+$" }
      }
    },
    "oauthScopes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[!#-\\[\\]-~]+$" }
    },
    "oauthClientId": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^(?=.*\\S)[^\\u0000-\\u001F\\u007F-\\u009F]+$" },
    "oauthParameter": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$" },
    "soapHttpRequestMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "action"],
      "properties": {
        "version": { "enum": ["1.1", "1.2"] },
        "action": { "type": "string", "minLength": 3, "maxLength": 2048, "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s\\u0000-\\u001F\\u007F-\\u009F\"\\\\]+$" }
      }
    },
    "httpToken": { "type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[A-Za-z0-9!#$%&'*+.^_`|~-]+$" },
    "signingSlotKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z](?:[a-z0-9._-]{0,62}[a-z0-9])?$"
    },
    "safeSignedTokenHeader": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9!#$%&'*+.^_`|~-]+$"
    },
    "safeOpaqueSessionHeader": {
      "type": "string",
      "pattern": "^[A-Za-z0-9!#$%&'*+.^_`|~-]+$",
      "maxLength": 64
    },
    "safeHeader": {
      "type": "string",
      "pattern": "^(?!Authorization$|Cookie$|Host$|Forwarded$|X-Forwarded-|Proxy-)[A-Za-z0-9-]+$",
      "maxLength": 64
    }
  }
}
